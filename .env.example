# Optional, server-side only. Empty keeps the labelled demo available.
LTA_DATAMALL_ACCOUNT_KEY=
# OneMap access token. Current OneMap search and routing APIs require it.
ONEMAP_API_TOKEN=
# openrouteservice walking directions fallback. Keep this server-side.
OPENROUTESERVICE_API_KEY=
# Cloud Run supplies PORT automatically.
PORT=5173
